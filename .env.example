# Obligation Compiler — LLM Configuration (optional)
# The app works fully offline with the rule-based parser.
# Configure these to enable LLM-powered obligation extraction.

# OpenAI-compatible base URL (llama.cpp, LM Studio, vLLM, etc.)
# Example: http://127.0.0.1:1234/v1  (LM Studio default)
ACEDIA_LLM_BASE_URL=

# Model name as shown in your server (e.g., "google/gemma-4-e2b", "llama-3.2-3b")
ACEDIA_LLM_MODEL=

# API key if your server requires one (LM Studio usually doesn't)
ACEDIA_LLM_API_KEY=

# Request timeout in milliseconds (default: 120000)
# Increase if your model runs on CPU and is slow.
# ACEDIA_LLM_TIMEOUT_MS=120000